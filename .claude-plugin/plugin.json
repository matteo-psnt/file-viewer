{
  "name": "file-viewer",
  "displayName": "File Viewer",
  "version": "0.3.0",
  "description": "Inline previews of PDFs, Office files, images and animated GIFs in Claude Code, with a paging viewer and a preview tool Claude can call",
  "author": {
    "name": "Matteo Pesenti"
  },
  "license": "MIT",
  "keywords": [
    "pdf",
    "slides",
    "powerpoint",
    "word",
    "excel",
    "office",
    "documents",
    "images",
    "preview",
    "viewer",
    "kitty",
    "ghostty"
  ],
  "types": "./types/index.d.ts",
  "homepage": "https://github.com/matteo-psnt/file-viewer",
  "documentationUrl": "https://github.com/matteo-psnt/file-viewer#readme",
  "repository": "https://github.com/matteo-psnt/file-viewer",
  "supportUrl": "https://github.com/matteo-psnt/file-viewer/issues",
  "privacyPolicyUrl": "https://github.com/matteo-psnt/file-viewer/blob/main/PRIVACY.md",
  "userConfig": {
    "transport": {
      "type": "string",
      "title": "Image transport",
      "description": "How pictures reach the terminal. auto picks file or bytes by asking the terminal.",
      "options": [
        "auto",
        "file",
        "bytes"
      ],
      "default": "auto"
    }
  }
}

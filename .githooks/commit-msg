#!/bin/sh
# Checks a commit subject against Conventional Commits, which release-please
# reads to pick the next version and write the CHANGELOG.
#
#   type(scope)!: summary
#
# Turn it on for this clone with: git config core.hooksPath .githooks
# CI runs it on each commit in a PR and on the PR title, since a squash merge
# makes the title the commit on main.

subject=$(sed -n '/^[^#]/{p;q;}' "$1")

case $subject in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ]"; then
  exit 0
fi

cat >&2 <<MSG
Not a Conventional Commit: $subject

  type(scope)!: summary

  type   one of ${types}
  scope  optional, e.g. converter, viewer, notice, doctor, demo
  !      optional, marks a breaking change

e.g. fix(viewer): keep the focus ring on the page buttons
MSG
exit 1
